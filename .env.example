# ==============================================================================
# SRIKARI ATI RUDRA MAHAYAGNAM — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# --- App Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase / PostgreSQL Database Configuration ---
# Project URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon / Public Key (Safe for browser/frontend usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Secret Key (Server-side only - NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Database Connection String (PostgreSQL Connection URL)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Direct Connection String for migrations (Session mode)
DIRECT_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres


# --- Cloudinary Configuration (Media & Asset Storage) ---
# Cloud Name (Found in Cloudinary Dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# API Key
CLOUDINARY_API_KEY=your_api_key

# API Secret (Server-side only)
CLOUDINARY_API_SECRET=your_api_secret

# Cloudinary Environment URL (Alternative single-string format)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Unsigned Upload Preset (Optional, for direct client-side uploads)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=srikari_uploads


# --- Payment Gateway (Optional / Ready for Integration) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# --- Notifications & Communication ---
WHATSAPP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
